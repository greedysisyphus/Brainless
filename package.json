{
  "name": "brainless",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/sync-data-for-dev.sh && vite",
    "start": "bash scripts/sync-data-for-dev.sh && vite",
    "build": "rm -rf docs/assets && vite build && npm run copy-data && node scripts/inject-version.js && npm run verify-build",
    "verify-build": "bash scripts/verify-build.sh",
    "copy-data": "mkdir -p docs/data && cp data/*.json docs/data/ 2>/dev/null || true",
    "pull-data": "node scripts/pull-data-from-github.js",
    "sync-data": "bash scripts/sync-data-for-dev.sh",
    "preview": "vite preview --base /Brainless/",
    "preview:local": "vite preview",
    "test": "node --test tests/goodsOrderSync.test.js tests/shifts.test.js",
    "deploy": "npm run build && gh-pages -d docs"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "firebase": "^10.14.1",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "ics": "^3.8.1",
    "jspdf": "^4.0.0",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.0"
  }
}
