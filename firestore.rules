rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 電子菜單 metadata：客人可讀 imageUrl；僅管理員可寫
    match /publicMenu/current {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 公開回饋中心：任何人可讀、發文、留言與投票；處理狀態與官方身分僅限管理員。
    match /feedback/{feedbackId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
          'title', 'body', 'category', 'status', 'author', 'creatorClientId',
          'voterIds', 'voteCount', 'commentCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.category in ['feature', 'bug', 'discussion']
        && request.resource.data.status == 'reviewing'
        && request.resource.data.author.name is string
        && request.resource.data.author.name.size() > 0
        && request.resource.data.author.name.size() <= 30
        && request.resource.data.author.store is string
        && request.resource.data.author.store.size() > 0
        && request.resource.data.creatorClientId is string
        && request.resource.data.voterIds is list
        && request.resource.data.voterIds.size() == 1
        && request.resource.data.voterIds[0] == request.resource.data.creatorClientId
        && request.resource.data.voteCount == 1
        && request.resource.data.commentCount == 0;

      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voterIds', 'voteCount', 'updatedAt'])
          && request.resource.data.voterIds is list
          && request.resource.data.voteCount == request.resource.data.voterIds.size()
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['commentCount', 'updatedAt'])
          && request.resource.data.commentCount == resource.data.commentCount + 1
        );

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly([
            'body', 'author', 'authorClientId', 'authorRole', 'createdAt'
          ])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.author.name is string
          && request.resource.data.author.name.size() > 0
          && request.resource.data.author.name.size() <= 30
          && request.resource.data.author.store is string
          && request.resource.data.author.store.size() > 0
          && request.resource.data.authorClientId is string
          && (
            request.resource.data.authorRole == 'member'
            || (request.resource.data.authorRole == 'admin' && isAdmin())
          );
        allow update, delete: if isAdmin();
      }
    }

    // 班表月份文件與支援班配對：所有人可讀，只有管理員能寫。
    //
    // 只有店長會匯入班表與修配對，同事只是看。開放寫入代表任何知道 project id 的人
    // 都能覆蓋或刪光整個月的班表，而且不會留下任何痕跡。
    //
    // 上車地點（shiftPeople）**不鎖** —— 那是同事自己設定的，鎖了就沒人能改。
    match /shiftMonths/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shiftSupportLinks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 既有功能暫時維持原權限；feedback 與班表已由上方規則獨立保護。
    //
    // ⚠️ Firestore 的規則是「OR」——只要有任何一條放行就放行。所以上面那兩條限制
    // 不會蓋掉這一條，必須在這裡把它們排除掉，否則等於沒鎖。
    match /{collectionId}/{document=**} {
      allow read, write: if collectionId != 'feedback'
        && collectionId != 'shiftMonths'
        && collectionId != 'shiftSupportLinks';
    }
  }
}
